generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MasterType {
  CATEGORY
  BRAND
  COLOR
  SIZE
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum SaleUnit {
  PIECES
  DOZEN
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  products  Product[]
  parties   Party[]
  suppliers Supplier[]
  purchases Purchase[]
  sales     Sale[]
  stocks    Stock[]
  branding  CompanyBranding?
  expenses  Expense[]
  reports   Report[]
}

model CompanyBranding {
  id             Int      @id @default(autoincrement())
  companyId      Int      @unique
  logoUrl        String?
  bgImageUrl     String?
  faviconUrl     String?
  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id           Int       @id @default(autoincrement())
  companyId    Int
  roleId       Int
  name         String
  dateOfBirth  DateTime  @db.Date
  mobile       String
  email        String
  gender       Gender
  address      String
  photoUrl     String
  signatureUrl String
  panUrl       String
  aadhaarUrl   String
  passwordHash String
  status       Boolean   @default(true)
  lastLogin    DateTime?
  resetToken   String?
  resetTokenExpiry DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  purchases     Purchase[]
  createdExpenses Expense[]
  generatedReports Report[]

  @@unique([companyId, email])
  @@unique([companyId, mobile])
  @@index([companyId, roleId])
}

model ProductMaster {
  id             Int           @id @default(autoincrement())
  companyId      Int
  type           MasterType
  name           String
  categoryId     Int?
  unit           SaleUnit      @default(PIECES)
  quantity       Int?
  purchaseAmount Decimal?
  saleAmount     Decimal?
  status         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  productsAsCategory Product[] @relation("ProductCategory")
  productsAsBrand    Product[] @relation("ProductBrand")
  productsAsColor    Product[] @relation("ProductColor")
  productsAsSize     Product[] @relation("ProductSize")
  salesAsSize        Sale[]    @relation("SaleSize")
  salesAsColor       Sale[]    @relation("SaleColor")
  stocksAsSize       Stock[]   @relation("StockSize")

  @@unique([companyId, type, name])
  @@index([companyId, type])
  @@index([companyId, categoryId])
}

model Product {
  id           Int      @id @default(autoincrement())
  companyId    Int
  productCode  String
  productName  String
  categoryId   Int
  brandId      Int
  colorId      Int
  sizeId       Int
  brandIds     Int[]    @default([])
  colorIds     Int[]    @default([])
  sizeIds      Int[]    @default([])
  productImage String?
  purchasePrice Decimal?
  quantity      Int?
  unit          SaleUnit @default(PIECES)
  gst           String
  itemCode     String
  status       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category ProductMaster @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  brand   ProductMaster @relation("ProductBrand", fields: [brandId], references: [id], onDelete: Restrict)
  color   ProductMaster @relation("ProductColor", fields: [colorId], references: [id], onDelete: Restrict)
  size    ProductMaster @relation("ProductSize", fields: [sizeId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, productCode])
  @@index([companyId, categoryId])
  @@index([companyId, brandId])
  @@index([companyId, colorId])
  @@index([companyId, sizeId])
}

model Party {
  id         Int      @id @default(autoincrement())
  companyId  Int
  partyName  String
  shopName   String
  mobile     String
  email      String?
  address    String
  city       String
  state      String
  country    String
  pincode    String
  status     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sales   Sale[]

  @@unique([companyId, mobile])
  @@index([companyId])
}

model Supplier {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  mobile    String
  email     String?
  address   String
  city      String
  state     String
  country   String
  pincode   String
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sales   Sale[]
  purchases Purchase[]

  @@unique([companyId, mobile])
  @@index([companyId])
}

model Purchase {
  id             Int           @id @default(autoincrement())
  companyId      Int
  purchaseNumber String
  supplierId     Int?
  supplierName   String?
  productCode    String?
  createdById    Int?
  invoiceDate    DateTime
  subTotal       Decimal       @db.Decimal(12, 2)
  gstAmount      Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  remainingBalance Decimal     @default(0) @db.Decimal(12, 2)
  paymentStatus  PaymentStatus @default(UNPAID)
  status         Boolean       @default(true)
  remarks        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy User? @relation(fields: [createdById], references: [id])

  @@unique([companyId, purchaseNumber])
  @@index([companyId, supplierId])
  @@index([companyId, paymentStatus])
  @@index([companyId, status])
}

model Sale {
  id          Int      @id @default(autoincrement())
  companyId   Int
  partyId     Int?
  partyName   String?
  supplierId  Int?
  supplierName String?
  supplierMobile String?
  supplierEmail String?
  supplierAddress String?
  productName String
  productCode String
  sizeId      Int
  colorId     Int
  quantity    Int
  unit        SaleUnit @default(PIECES)
  salePrice   Decimal  @db.Decimal(12, 2)
  purchasePrice Decimal @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  perSaleProfit Decimal @db.Decimal(12, 2) @default(0)
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: SetNull)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  size    ProductMaster @relation("SaleSize", fields: [sizeId], references: [id], onDelete: Restrict)
  color   ProductMaster @relation("SaleColor", fields: [colorId], references: [id], onDelete: Restrict)

  @@unique([companyId, productCode])
  @@index([companyId, partyId])
  @@index([companyId, supplierId])
  @@index([companyId, sizeId])
  @@index([companyId, colorId])
  @@index([companyId, status])
}

model Expense {
  id          Int      @id @default(autoincrement())
  companyId   Int
  category    String
  details     String?
  amount      Decimal  @db.Decimal(12, 2)
  paymentMode String
  billUrl     String?
  createdById Int?
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([companyId])
  @@index([companyId, category])
}

model Report {
  id           Int      @id @default(autoincrement())
  companyId    Int
  type         String
  periodStart  DateTime
  periodEnd    DateTime
  data         Json
  generatedById Int?
  createdAt    DateTime @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  generatedBy User?   @relation(fields: [generatedById], references: [id])

  @@index([companyId, type])
  @@index([companyId, periodStart])
}

model Stock {
  id          Int      @id @default(autoincrement())
  companyId   Int
  productCode String
  productName String
  sizeId      Int
  qtyIn       Int      @default(0)
  qtyOut      Int      @default(0)
  balanceStock Int
  salePrice   Decimal  @db.Decimal(12, 2)
  saleValue   Decimal  @db.Decimal(12, 2)
  remarks     String?
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  size    ProductMaster @relation("StockSize", fields: [sizeId], references: [id], onDelete: Restrict)

  @@unique([companyId, productCode])
  @@index([companyId, sizeId])
  @@index([companyId, status])
}

// Used by express-session via connect-pg-simple.
model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json
  expire DateTime

  @@index([expire])
  @@map("session")
}
